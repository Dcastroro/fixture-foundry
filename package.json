    "url": "git+https://github.com/Dcastroro/fixture-foundry.git"
  },
  "homepage": "https://github.com/Dcastroro/fixture-foundry#readme",
  "bugs": {
    "url": "https://github.com/Dcastroro/fixture-foundry/issues"
  },
  "scripts": {
